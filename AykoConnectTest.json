{
  "openapi": "3.0.3",
  "info": {
    "title": "Ayko Connect",
    "description": "Integra sistemas comerciais e de faturação ao ERP Sankhya por serviços do add-on Ayko Connect.\nClientes autenticados enviam todos os comandos ao broker Sankhya, com o identificador do serviço em `serviceName` e o conteúdo no envelope `requestBody.request`.",
    "version": "1.4.4",
    "contact": {
      "email": "jaksciley.araujo@ayko.tech"
    }
  },
  "servers": [
    {
      "url": "{baseUrl}",
      "variables": {
        "baseUrl": {
          "default": "https://api.ayko.tech"
        }
      }
    }
  ],
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key"
      }
    },
    "schemas": {
      "StandardError": {
        "type": "object",
        "properties": {
          "codigo": {
            "type": "string"
          },
          "mensagem": {
            "type": "string"
          }
        }
      },
      "EventResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "1"
          },
          "serviceName": {
            "type": "string"
          },
          "responseBody": {
            "type": "object",
            "properties": {
              "body": {
                "type": "object",
                "properties": {
                  "externalId": {
                    "type": "string"
                  },
                  "status": {
                    "type": "string",
                    "example": "SUCCESS"
                  },
                  "message": {
                    "type": "string"
                  },
                  "eventId": {
                    "type": "integer"
                  },
                  "sankhyaId": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
  "paths": {
    "/aykoconnect/service.sbr/AykoPartnerProfileSP.Get": {
      "post": {
        "tags": ["Partner"],
        "summary": "Consultar Parceiros",
        "operationId": "getPartner",
        "parameters": [
          {
            "name": "serviceName",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "default": "AykoPartnerProfileSP.Get"
            }
          },
          {
            "name": "outputType",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "default": "json"
            }
          },
          {
            "name": "mgeSession",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "requestBody": {
                    "type": "object",
                    "properties": {
                      "request": {
                        "type": "object",
                        "properties": {
                          "expand": {
                            "type": "array",
                            "items": { "type": "string" }
                          },
                          "codParc": { "type": "integer" },
                          "document": { "type": "string" }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Consulta executada com sucesso." },
          "400": { "description": "Envelope, parâmetros ou filtros inválidos." },
          "401": { "description": "Sessão ou chave de API inválida." }
        }
      }
    },
    "/aykoconnect/service.sbr/AykoPartnerProfileSP.CreateEvent": {
      "post": {
        "tags": ["Partner"],
        "summary": "Criar Parceiro",
        "operationId": "createPartner",
        "parameters": [
          {
            "name": "serviceName",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "default": "AykoPartnerProfileSP.CreateEvent" }
          },
          {
            "name": "outputType",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "default": "json" }
          },
          {
            "name": "mgeSession",
            "in": "query",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "requestBody": {
                    "type": "object",
                    "properties": {
                      "request": {
                        "type": "object",
                        "properties": {
                          "sourceSystem": { "type": "string" },
                          "externalId": { "type": "string" },
                          "webhookUrl": { "type": "string", "format": "uri" },
                          "codParc": { "type": "integer" },
                          "document": { "type": "string" },
                          "name": { "type": "string" },
                          "legalName": { "type": "string" },
                          "tradeName": { "type": "string" },
                          "personType": { "type": "string" },
                          "active": { "type": "boolean" },
                          "client": { "type": "boolean" },
                          "supplier": { "type": "boolean" },
                          "cep": { "type": "string" },
                          "street": { "type": "string" },
                          "city": { "type": "string" },
                          "state": { "type": "string" },
                          "contacts": {
                            "type": "array",
                            "items": { "type": "object" }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Evento de integração registado ou processado.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/EventResponse" }
              }
            }
          },
          "400": { "description": "Requisição inválida." },
          "401": { "description": "Não autorizado." },
          "422": { "description": "Regra de negócio rejeitou o processamento." }
        }
      }
    },
    "/aykoconnect/service.sbr/AykoPartnerProfileSP.UpdateEvent": {
      "post": {
        "tags": ["Partner"],
        "summary": "Atualizar Parceiro",
        "operationId": "updatePartner",
        "parameters": [
          { "name": "serviceName", "in": "query", "required": true, "schema": { "type": "string", "default": "AykoPartnerProfileSP.UpdateEvent" } },
          { "name": "outputType", "in": "query", "required": true, "schema": { "type": "string", "default": "json" } },
          { "name": "mgeSession", "in": "query", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "type": "object" }
            }
          }
        },
        "responses": {
          "200": { "description": "Evento processado com sucesso." },
          "422": { "description": "Erro de regra de negócio." }
        }
      }
    },
